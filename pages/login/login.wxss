.reg { min-height: 100vh; background: var(--card-bg); }
.reg-hero {
  background: linear-gradient(135deg, var(--primary) 0%, var(--brand-2) 100%);
  padding: 70rpx 48rpx 130rpx;
  color: #fff;
}
.reg-title { font-size: 50rpx; font-weight: 800; }
.reg-sub { font-size: 26rpx; opacity: 0.9; margin-top: 12rpx; }

.reg-card {
  position: relative;
  z-index: 2;
  margin: -90rpx 32rpx 40rpx;
  background: var(--card-bg);
  border-radius: 32rpx;
  padding: 40rpx 36rpx 48rpx;
  box-shadow: 0 16rpx 50rpx rgba(61, 90, 254, 0.12);
}

.role-seg {
  display: flex;
  background: var(--fill);
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 36rpx;
}
.role-seg-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--text-2);
  border-radius: 16rpx;
  transition: all 0.2s;
}
.role-seg-item.on {
  background: var(--card-bg);
  color: var(--primary-deep);
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(61, 90, 254, 0.15);
}

.field {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid var(--fill-4);
  padding: 8rpx 0;
  margin-bottom: 12rpx;
}
.field-ico { font-size: 34rpx; margin-right: 20rpx; width: 44rpx; text-align: center; }
.field-input { flex: 1; font-size: 30rpx; padding: 24rpx 0; }

.forgot { margin: 8rpx 0 36rpx; }
.forgot .muted { font-size: 22rpx; }
.link { color: var(--primary-deep); font-size: 24rpx; }

.submit { margin-bottom: 24rpx; }
.demo { width: 100%; }
.to-login { text-align: center; font-size: 26rpx; color: var(--text-sub); margin-top: 30rpx; }

/* 微信一键登录 */
.wx-btn {
  width: 100%;
  background: linear-gradient(135deg, #2DC100, var(--accent));
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 26rpx 0;
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(45, 193, 0, 0.3);
}
.wx-btn::after { border: none; }
.wx-ico { margin-right: 10rpx; }
.wx-tip { text-align: center; font-size: 22rpx; margin-top: 16rpx; }

.divider {
  display: flex;
  align-items: center;
  text-align: center;
  color: #C2C6D2;
  font-size: 22rpx;
  margin: 40rpx 0 28rpx;
}
.divider::before, .divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: #EDEFF4;
}
.divider text { margin: 0 20rpx; }
