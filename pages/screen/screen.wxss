.screen {
  min-height: 100vh;
  background: radial-gradient(circle at 50% 0%, #1b2a6b 0%, #0b1030 60%, #06081a 100%);
  color: #fff;
  display: flex;
  flex-direction: column;
  padding: 40rpx 48rpx 60rpx;
  box-sizing: border-box;
}

.scr-top { display: flex; align-items: center; justify-content: space-between; }
.scr-right { display: flex; align-items: center; gap: 24rpx; }
.scr-switch { font-size: 24rpx; color: #9aa4d6; text-decoration: underline; }
.scr-brand { font-size: 34rpx; font-weight: 700; opacity: 0.9; }
.scr-status { display: flex; align-items: center; font-size: 24rpx; color: #9aa4d6; }
.scr-status .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff5a5f;
  margin-right: 10rpx;
}
.scr-status.on .dot { background: #24C8A0; }
.scr-status.on { color: #7fe9cf; }

.scr-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.scr-text {
  font-size: 96rpx;
  font-weight: 800;
  line-height: 1.4;
  letter-spacing: 2rpx;
  text-shadow: 0 8rpx 40rpx rgba(91, 124, 255, 0.6);
  padding: 0 20rpx;
}
.scr-text.placeholder { font-size: 52rpx; font-weight: 500; color: #4a5488; text-shadow: none; }

/* 声波条 */
.scr-wave { display: flex; align-items: flex-end; gap: 12rpx; height: 60rpx; margin-top: 60rpx; }
.scr-wave .bar {
  width: 12rpx;
  height: 20rpx;
  background: linear-gradient(#5B7CFF, #24C8A0);
  border-radius: 8rpx;
}
.scr-wave.playing .bar { animation: bounce 0.9s ease-in-out infinite; }
.scr-wave.playing .bar:nth-child(2) { animation-delay: 0.15s; }
.scr-wave.playing .bar:nth-child(3) { animation-delay: 0.3s; }
.scr-wave.playing .bar:nth-child(4) { animation-delay: 0.45s; }
.scr-wave.playing .bar:nth-child(5) { animation-delay: 0.6s; }
@keyframes bounce {
  0%, 100% { height: 16rpx; }
  50% { height: 56rpx; }
}

.scr-bottom { display: flex; justify-content: center; }
.replay {
  font-size: 30rpx;
  color: #cdd5ff;
  border: 2rpx solid rgba(205, 213, 255, 0.4);
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
}

/* 绑定班级界面 */
.bind-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.bind-logo { font-size: 120rpx; margin-bottom: 20rpx; }
.bind-title { font-size: 52rpx; font-weight: 800; margin-bottom: 16rpx; }
.bind-tip { font-size: 26rpx; color: #8f9ac9; margin-bottom: 48rpx; }
.bind-input {
  width: 560rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(205, 213, 255, 0.35);
  border-radius: 999rpx;
  padding: 26rpx 40rpx;
  font-size: 34rpx;
  color: #fff;
  letter-spacing: 4rpx;
  text-align: center;
  margin-bottom: 32rpx;
}
.bind-btn {
  width: 560rpx;
  background: linear-gradient(135deg, #5B7CFF, #24C8A0);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 24rpx 0;
  border: none;
}
.bind-btn::after { border: none; }
