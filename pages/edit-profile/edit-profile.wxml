<view class="edit-page">
  <!-- 头像 -->
  <view class="avatar-row">
    <view class="big-avatar">{{profile.name[0] || '?'}}</view>
    <view class="avatar-tip muted">修改后点击底部「保存」</view>
  </view>

  <view class="card form-card">
    <view class="f-row">
      <text class="f-label">姓名</text>
      <input class="f-input" data-field="name" value="{{profile.name}}" bindinput="onInput" placeholder="请输入姓名" />
    </view>

    <picker mode="selector" range="{{genders}}" value="{{genderIndex}}" bindchange="onGender">
      <view class="f-row">
        <text class="f-label">性别</text>
        <view class="f-input f-picker">{{profile.gender}} ›</view>
      </view>
    </picker>

    <view class="f-row">
      <text class="f-label">手机号</text>
      <input class="f-input" type="number" maxlength="11" data-field="phone" value="{{profile.phone}}" bindinput="onInput" placeholder="选填" />
    </view>

    <!-- 收集手机号前必须取得用户明确同意（审核要求） -->
    <view class="f-consent">
      <view class="f-consent-main">
        <switch class="f-switch" checked="{{phoneAgree}}" color="#5B7CFF" bindchange="onPhoneAgree" />
        <view class="f-consent-text">
          <text>我同意为班级事务联系之目的保存我的手机号</text>
          <view class="f-consent-links">
            <text class="pp-link" data-tab="privacy" bindtap="openPrivacy">《隐私政策》</text>
            <text class="pp-sep">·</text>
            <text class="pp-link" data-tab="agreement" bindtap="openPrivacy">《用户服务协议》</text>
          </view>
        </view>
      </view>
      <view class="f-consent-tip muted">手机号选填，不填写或不勾选不影响任何功能使用；关闭开关即撤回同意，保存时不会上传手机号。</view>
    </view>

    <!-- 老师专属 -->
    <block wx:if="{{role === 'teacher'}}">
      <view class="f-row">
        <text class="f-label">职称</text>
        <input class="f-input" data-field="title" value="{{profile.title}}" bindinput="onInput" placeholder="如：班主任 / 教研组长" />
      </view>
      <view class="f-row">
        <text class="f-label">任教学科</text>
        <input class="f-input" data-field="subject" value="{{profile.subject}}" bindinput="onInput" placeholder="如：数学" />
      </view>
    </block>

    <!-- 学生专属 -->
    <block wx:else>
      <view class="f-row">
        <text class="f-label">学号</text>
        <input class="f-input" data-field="studentNo" value="{{profile.studentNo}}" bindinput="onInput" placeholder="请输入学号" />
      </view>
    </block>

    <view class="f-row">
      <text class="f-label">所在班级</text>
      <input class="f-input" data-field="className" value="{{profile.className}}" bindinput="onInput" placeholder="如：高三(2)班" />
    </view>

    <view class="f-row column">
      <text class="f-label">个性签名</text>
      <textarea class="f-textarea" data-field="signature" value="{{profile.signature}}" bindinput="onInput" placeholder="写点什么吧～" />
    </view>
  </view>

  <view class="save-bar">
    <button class="btn-primary" bindtap="save">保存</button>
  </view>
</view>
