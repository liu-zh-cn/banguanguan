.edit-page {
  min-height: 100vh;
  background: var(--page-bg);
  padding: 40rpx 0 calc(160rpx + env(safe-area-inset-bottom));
}

.avatar-row { display: flex; flex-direction: column; align-items: center; padding: 20rpx 0 40rpx; }
.big-avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #5B7CFF, #7E5BFF);
  color: #fff;
  font-size: 68rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.form-card { padding: 8rpx 32rpx; }
.f-row {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #F2F3F7;
}
.f-row:last-child { border-bottom: none; }
.f-row.column { flex-direction: column; align-items: stretch; }
.f-label { width: 160rpx; font-size: 28rpx; color: #6B7180; }
.f-row.column .f-label { width: auto; margin-bottom: 16rpx; }
.f-input { flex: 1; font-size: 28rpx; color: #1F2430; }
.f-picker { text-align: right; color: #8A90A2; }
.f-textarea { width: 100%; height: 120rpx; font-size: 28rpx; }

/* 手机号授权同意区（审核要求：收集个人信息前须取得同意） */
.f-consent {
  padding: 24rpx 0 28rpx;
  border-bottom: 2rpx solid #F2F3F7;
}
.f-consent-main {
  display: flex;
  align-items: flex-start;
}
.f-switch {
  transform: scale(0.85);
  transform-origin: left center;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.f-consent-text {
  flex: 1;
  font-size: 26rpx;
  color: #1F2430;
  line-height: 1.6;
  padding-top: 4rpx;
}
.f-consent-links { margin-top: 6rpx; }
.pp-link { color: #5B7CFF; font-weight: 600; }
.pp-sep { color: #C6CAD6; margin: 0 6rpx; }
.f-consent-tip {
  font-size: 22rpx;
  line-height: 1.6;
  margin-top: 12rpx;
  padding-left: 4rpx;
}

.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: #fff;
  box-shadow: 0 -6rpx 30rpx rgba(0, 0, 0, 0.06);
}
