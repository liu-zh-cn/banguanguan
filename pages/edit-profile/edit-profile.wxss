.edit-page {
  min-height: 100vh;
  background: var(--page-bg);
  padding: 40rpx 0 calc(160rpx + env(safe-area-inset-bottom));
}

.avatar-row { display: flex; flex-direction: column; align-items: center; padding: 20rpx 0 40rpx; }
.big-avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #5B7CFF, #7E5BFF);
  color: #fff;
  font-size: 68rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.form-card { padding: 8rpx 32rpx; }
.f-row {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #F2F3F7;
}
.f-row:last-child { border-bottom: none; }
.f-row.column { flex-direction: column; align-items: stretch; }
.f-label { width: 160rpx; font-size: 28rpx; color: #6B7180; }
.f-row.column .f-label { width: auto; margin-bottom: 16rpx; }
.f-input { flex: 1; font-size: 28rpx; color: #1F2430; }
.f-picker { text-align: right; color: #8A90A2; }
.f-textarea { width: 100%; height: 120rpx; font-size: 28rpx; }

.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: #fff;
  box-shadow: 0 -6rpx 30rpx rgba(0, 0, 0, 0.06);
}
