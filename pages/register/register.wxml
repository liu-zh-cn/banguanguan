<view class="reg">
  <view class="reg-hero">
    <view class="reg-title">创建账号</view>
    <view class="reg-sub">绑定微信身份，几秒完成注册（免费）</view>
  </view>

  <view class="reg-card">
    <!-- 身份切换 -->
    <view class="role-seg">
      <view class="role-seg-item {{role === 'teacher' ? 'on' : ''}}" data-role="teacher" bindtap="setRole">👩‍🏫 我是老师</view>
      <view class="role-seg-item {{role === 'student' ? 'on' : ''}}" data-role="student" bindtap="setRole">🎓 我是学生</view>
    </view>

    <view class="field">
      <text class="field-ico">👤</text>
      <input class="field-input" placeholder="真实姓名" value="{{name}}" data-field="name" bindinput="onInput" />
    </view>

    <view class="field">
      <text class="field-ico">🏫</text>
      <input class="field-input" placeholder="所在班级，如：高三(2)班" value="{{className}}" data-field="className" bindinput="onInput" />
    </view>

    <view class="field" wx:if="{{role === 'teacher'}}">
      <text class="field-ico">📚</text>
      <input class="field-input" placeholder="任教学科，如：数学" value="{{subject}}" data-field="subject" bindinput="onInput" />
    </view>

    <view class="field" wx:else>
      <text class="field-ico">🔢</text>
      <input class="field-input" placeholder="学号，如：05" value="{{studentNo}}" data-field="studentNo" bindinput="onInput" />
    </view>

    <view class="wx-note muted">
      <text>🔒</text>
      <text class="wx-note-text">无需手机号/验证码，注册将自动绑定你的微信 openid</text>
    </view>

    <button class="btn-primary submit" bindtap="submit" loading="{{submitting}}">完 成 注 册</button>

    <view class="to-login">已有账号？<text class="link" bindtap="goLogin">去登录 ›</text></view>
  </view>
</view>
