.set-page { min-height: 100vh; padding-top: 20rpx; }

.acc-card { padding: 12rpx 32rpx; }
.acc-card .row-between { padding: 26rpx 0; border-bottom: 2rpx solid var(--line); }
.acc-card .row-between:last-child { border-bottom: none; }
.acc-label { font-size: 28rpx; color: var(--text-2); }
.acc-val { font-size: 28rpx; font-weight: 600; color: var(--text); }

.menu-card { padding: 8rpx 32rpx; }
.s-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.s-item:last-child { border-bottom: none; }
.s-ico { font-size: 40rpx; margin-right: 24rpx; }
.s-label { flex: 1; font-size: 30rpx; }
.s-val { font-size: 26rpx; color: var(--text-sub); margin-right: 12rpx; }
.s-arrow { color: var(--line-2); font-size: 40rpx; }

.logout { text-align: center; color: var(--danger); font-size: 30rpx; font-weight: 600; padding: 6rpx 0; }
