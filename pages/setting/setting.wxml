<view class="set-page">
  <view class="card acc-card">
    <view class="row-between">
      <text class="acc-label">当前身份</text>
      <text class="acc-val">{{role === 'student' ? '学生' : '老师'}}</text>
    </view>
    <view class="row-between">
      <text class="acc-label">昵称</text>
      <text class="acc-val">{{profile.name || '未设置'}}</text>
    </view>
    <view class="row-between">
      <text class="acc-label">所在班级</text>
      <text class="acc-val">{{profile.className || '未设置'}}</text>
    </view>
    <view class="row-between">
      <text class="acc-label">登录账号 openid</text>
      <text class="acc-val muted">{{openidShort}}</text>
    </view>
  </view>

  <view class="card menu-card">
    <view class="s-item" bindtap="goEdit">
      <text class="s-ico">📝</text><text class="s-label">修改资料</text><text class="s-arrow">›</text>
    </view>
    <view class="s-item" bindtap="clearCache">
      <text class="s-ico">🧹</text><text class="s-label">清除本地缓存</text><text class="s-arrow">›</text>
    </view>
    <view class="s-item" bindtap="about">
      <text class="s-ico">ℹ️</text><text class="s-label">关于班管管</text><text class="s-arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="logout" bindtap="logout">退出登录 / 切换身份</view>
  </view>
</view>
