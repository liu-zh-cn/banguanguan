<view class="page si-page {{themeClass}}">
  <view class="hero">
    <view class="hero-title">录入成绩</view>
    <view class="hero-sub">{{examName || '…'}} · 满分 {{fullScore}} 分</view>
  </view>

  <!-- 科目切换 -->
  <view class="si-chips">
    <view
      class="si-chip {{subjectIndex === index ? 'si-chip--on' : ''}}"
      wx:for="{{subjects}}"
      wx:key="*this"
      wx:for-index="index"
      data-index="{{index}}"
      bindtap="pickSubject"
    >{{item}}</view>
  </view>

  <!-- 批量操作：粘贴录入 / 导出整张表 -->
  <view class="si-tools">
    <view class="si-tool" bindtap="openBatch">📋 批量粘贴</view>
    <view class="si-tool" bindtap="copyScores">📤 复制成绩表</view>
  </view>

  <view class="card si-batch" wx:if="{{batchOpen}}">
    <view class="section-title">批量粘贴 · {{subject}}</view>
    <textarea
      class="si-batch-input"
      value="{{batchText}}"
      bindinput="onBatchInput"
      maxlength="-1"
      placeholder="每行一条，例如：&#10;01 95&#10;02 88&#10;（也可以只写分数，按名单顺序从上往下填）"
    />
    <view class="si-batch-tip">学号+分数 或 只写分数；空格、逗号、Tab 都认。填进表格后还要点保存才生效。</view>
    <view class="si-batch-bar">
      <view class="si-btn si-btn--ghost" bindtap="closeBatch">取消</view>
      <view class="si-btn si-btn--primary" bindtap="applyBatch">填进表格</view>
    </view>
  </view>

  <!-- 学生成绩列表 -->
  <view class="card">
    <view class="section-title">{{subject}} · 共 {{rows.length}} 人</view>
    <view class="si-row" wx:for="{{rows}}" wx:key="openid">
      <view class="si-no">{{item.no}}</view>
      <view class="si-name">{{item.name}}</view>
      <input
        class="si-input"
        type="number"
        placeholder="{{fullScore}}"
        value="{{item.val}}"
        data-index="{{index}}"
        bindinput="onInput"
      />
    </view>
    <view class="si-empty" wx:if="{{!loading && !rows.length}}">班里还没有学生，让学生用邀请码加入后就能录成绩了</view>
  </view>

  <view class="si-savebar">
    <button class="btn-primary si-save" bindtap="save">{{saving ? '保存中…' : '保存「' + subject + '」成绩'}}</button>
  </view>
</view>
