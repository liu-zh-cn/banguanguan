.hero { padding-bottom: 40rpx; }

.hero-create {
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  color: #fff;
  font-size: 24rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
}

.search-box {
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
}
.search-ico { font-size: 30rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 28rpx; color: var(--text); }

.filter-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 28rpx 4rpx;
}
.roster-btn {
  margin-left: auto;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--primary-deep);
  background: var(--primary-light);
}
.chip {
  padding: 14rpx 34rpx;
  background: var(--card-bg);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-2);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.04);
}
.chip--on { background: var(--primary); color: #fff; font-weight: 700; }

.stu-item { display: flex; align-items: center; padding: 26rpx 30rpx; margin: 20rpx 28rpx; }
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.stu-main { flex: 1; }
.stu-name { font-size: 32rpx; font-weight: 700; margin-right: 16rpx; }
.stu-duty {
  font-size: 20rpx;
  color: var(--primary-deep);
  background: var(--primary-light);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.stu-score { text-align: right; }
.score-num { font-size: 40rpx; font-weight: 800; color: var(--text); }
.score-warn { color: var(--danger); }

.empty { text-align: center; color: var(--text-3); padding: 80rpx 0; }

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #fff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 34rpx rgba(61, 90, 254, 0.4);
  z-index: 100;
}

/* 教师团队 / 待审核申请 */
.teacher-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--fill);
}
.teacher-item:last-child { border-bottom: none; }
.t-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.mini-btn {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: var(--fill);
  color: var(--text-5);
  margin-left: 12rpx;
}
.mini-btn--primary { background: var(--primary-light); color: var(--primary-deep); font-weight: 600; }
.mini-btn--danger { background: #FFE6E7; color: #D63B41; font-weight: 600; }
