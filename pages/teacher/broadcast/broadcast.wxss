.bc-page { min-height: 100vh; padding-bottom: 60rpx; }

.quick-form { display: flex; align-items: center; margin-bottom: 20rpx; }
.quick-form:last-child { margin-bottom: 0; }
.q-text { font-size: 30rpx; color: #3A4152; }
.q-input {
  min-width: 180rpx;
  border-bottom: 2rpx solid #D8DCEA;
  padding: 10rpx 8rpx;
  margin: 0 12rpx;
  font-size: 30rpx;
  text-align: center;
}
.q-input.grow { flex: 1; }

.custom-area {
  width: 100%;
  height: 160rpx;
  font-size: 30rpx;
  background: #F7F8FC;
  border-radius: 16rpx;
  padding: 24rpx;
}

.send-wrap { padding: 12rpx 28rpx; }
.send-btn { width: 100%; }
.preview-link {
  text-align: center;
  color: var(--primary-deep);
  font-size: 28rpx;
  margin-top: 24rpx;
}

.his-item {
  display: flex;
  align-items: baseline;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F2F3F7;
}
.his-item:last-child { border-bottom: none; }
.his-time { width: 96rpx; flex-shrink: 0; }
.his-text { flex: 1; font-size: 28rpx; color: #3A4152; }
