.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.form-item.column { flex-direction: column; align-items: stretch; }
.form-label { width: 130rpx; color: var(--text-2); font-size: 28rpx; }
.form-item.column .form-label { width: auto; margin-bottom: 16rpx; }
.form-input { flex: 1; font-size: 28rpx; }
.form-textarea { width: 100%; height: 140rpx; font-size: 28rpx; }
.picker { flex: 1; font-size: 28rpx; color: var(--text); }

.submit-btn { margin-top: 36rpx; }

.hw-item { padding: 24rpx 0; border-bottom: 2rpx solid var(--line); }
.hw-item:last-child { border-bottom: none; }
.hw-title { font-size: 30rpx; font-weight: 600; margin-left: 16rpx; }
.del { font-size: 24rpx; color: var(--danger); }
.hw-meta { margin: 10rpx 0 14rpx; }

.progress-row { display: flex; align-items: center; }
.progress-track {
  flex: 1;
  height: 16rpx;
  background: var(--fill-2);
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--primary), var(--accent));
}
.progress-text { font-size: 22rpx; color: var(--text-2); margin-left: 16rpx; }

/* 「查看未交」入口：低调但可点，避免和整行的其它信息抢注意力 */
.hw-link { color: var(--primary); }
