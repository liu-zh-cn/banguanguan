.hero-badge {
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
}

/* 关键指标 */
.stat-grid {
  display: flex;
  padding: 30rpx 10rpx;
}
.stat-cell { flex: 1; text-align: center; position: relative; }
.stat-cell:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 2rpx;
  background: #EEF0F5;
}
.stat-num { font-size: 46rpx; font-weight: 800; color: #1F2430; }
.stat-num.text-green { color: #0F9D77; }
.stat-num.text-blue { color: #3D5AFE; }
.stat-label { font-size: 24rpx; color: #8A90A2; margin-top: 8rpx; }

/* 图表切换入口 */
.switch-bar {
  display: flex;
  background: #F0F2F8;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 28rpx;
}
.switch-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #6B7180;
  border-radius: 16rpx;
  transition: all 0.2s;
}
.switch-item--on {
  background: #fff;
  color: #3D5AFE;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(61, 90, 254, 0.15);
}
.chart-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.chart-title { font-size: 30rpx; font-weight: 700; }
.chart-desc { font-size: 22rpx; color: #A6ABC0; }

/* 快捷操作 */
.quick-row { display: flex; }
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #5A6072;
}
.quick-ico {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
