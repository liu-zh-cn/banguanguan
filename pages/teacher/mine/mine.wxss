.profile {
  background: linear-gradient(135deg, #5B7CFF 0%, #7E5BFF 100%);
  padding: 50rpx 36rpx 100rpx;
  display: flex;
  align-items: center;
  color: #fff;
}
.p-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.25);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  font-size: 56rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}
.p-info { flex: 1; }
.p-name { font-size: 40rpx; font-weight: 700; }
.p-role { font-size: 24rpx; opacity: 0.9; margin-top: 8rpx; }
.p-edit { font-size: 24rpx; opacity: 0.9; }

.stat-card {
  display: flex;
  margin-top: -60rpx;
  position: relative;
  z-index: 2;
  padding: 30rpx 0;
}
.p-stat { flex: 1; text-align: center; }
.p-num { font-size: 40rpx; font-weight: 800; color: var(--primary-deep); display: block; }
.p-lb { font-size: 24rpx; color: #8A90A2; }

.menu-card { padding: 8rpx 32rpx; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #F2F3F7;
}
.menu-item:last-child { border-bottom: none; }
.menu-ico { font-size: 40rpx; margin-right: 24rpx; }
.menu-label { flex: 1; font-size: 30rpx; }
.menu-extra { margin-right: 12rpx; }
.menu-arrow { color: #C7CBDA; font-size: 40rpx; }

.switch-btn {
  text-align: center;
  color: var(--danger);
  font-size: 30rpx;
  font-weight: 600;
  padding: 6rpx 0;
}
