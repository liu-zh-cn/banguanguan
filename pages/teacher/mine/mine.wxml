<view class="page">
  <view class="profile">
    <view class="p-avatar">{{profile.name[0] || '李'}}</view>
    <view class="p-info">
      <view class="p-name">{{profile.name}}</view>
      <view class="p-role">{{profile.className ? profile.title + " · " + profile.className : profile.title}}</view>
    </view>
    <view class="p-edit" bindtap="goEdit">编辑 ›</view>
  </view>

  <view class="card stat-card">
    <view class="p-stat"><text class="p-num">{{stats.student}}</text><text class="p-lb">学生</text></view>
    <view class="p-stat"><text class="p-num">{{stats.homework}}</text><text class="p-lb">已布置作业</text></view>
    <view class="p-stat"><text class="p-num">{{stats.exam}}</text><text class="p-lb">未发布成绩</text></view>
  </view>

  <view class="card menu-card">
    <view class="menu-item" wx:for="{{menus}}" wx:key="label" data-label="{{item.label}}" data-action="{{item.action}}" bindtap="onMenu">
      <text class="menu-ico">{{item.icon}}</text>
      <text class="menu-label">{{item.label}}</text>
      <text class="menu-extra muted" wx:if="{{item.extra}}">{{item.extra}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="switch-btn" bindtap="switchRole">切换身份 / 退出登录</view>
  </view>

  <bottom-nav role="teacher" active="{{4}}" />
</view>
