.sum-num { font-size: 28rpx; font-weight: 600; }
.add-btn {
  color: var(--primary-deep);
  font-size: 28rpx;
  font-weight: 600;
}

.exam-item { padding: 28rpx 0; border-bottom: 2rpx solid var(--line); }
.exam-item:last-child { border-bottom: none; }
.exam-name { font-size: 32rpx; font-weight: 700; }
.exam-meta { margin: 12rpx 0 20rpx; }

.exam-actions { display: flex; gap: 20rpx; }
.mini-btn {
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: var(--fill);
  color: var(--text-5);
}
.mini-btn--primary { background: var(--primary-light); color: var(--primary-deep); font-weight: 600; }
.mini-btn--warn { background: #FFE9D6; color: #D9770A; font-weight: 600; }

/* 试卷满分选择 */
.fs-bar { display: flex; gap: 16rpx; }
.fs-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: var(--fill);
  color: var(--text-2);
}
.fs-item--on {
  background: var(--primary-light);
  color: var(--primary-deep);
  font-weight: 700;
}
.fs-tip { margin-top: 18rpx; }
