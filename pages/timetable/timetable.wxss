.tt-page {
  min-height: 100vh;
  padding: 24rpx 20rpx 60rpx;
}

.tt-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx 4rpx 20rpx;
}
.tt-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
}
.tt-sub {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 6 列：节次 + 周一到周五 */
.tt-grid {
  display: grid;
  grid-template-columns: 64rpx repeat(5, 1fr);
  gap: 8rpx;
  padding: 16rpx;
  background: var(--card-bg);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 45, 92, 0.06);
}

.tt-corner,
.tt-day {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-sub);
  background: #f3f5fb;
  border-radius: 12rpx;
}
.tt-day {
  color: var(--text);
}

.tt-period {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  background: #f3f5fb;
  border-radius: 12rpx;
}

.tt-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  padding: 6rpx;
  font-size: 24rpx;
  line-height: 1.25;
  text-align: center;
  word-break: break-all;
  color: var(--text-sub);
  background: #fafbfe;
  border: 1rpx solid #eef0f7;
  border-radius: 12rpx;
}

.tt-cell.is-on {
  color: var(--primary-deep);
  font-weight: 600;
  background: var(--primary-light);
  border-color: #dbe2ff;
}

.tt-foot {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-sub);
}

.tt-note {
  margin-top: 28rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-sub);
}
