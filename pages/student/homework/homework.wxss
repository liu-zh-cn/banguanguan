.tab-row {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 28rpx 0;
}
.tab {
  padding: 14rpx 32rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6B7180;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.04);
}
.tab--on { background: var(--primary); color: #fff; font-weight: 700; }

.hw-item { margin: 22rpx 28rpx; }
.hw-title { font-size: 30rpx; font-weight: 600; margin-left: 14rpx; }
.hw-deadline { margin: 16rpx 0; }

.progress-row { display: flex; align-items: center; }
.progress-track {
  flex: 1;
  height: 16rpx;
  background: #EEF0F5;
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5B7CFF, #24C8A0);
}
.bar-red { background: linear-gradient(90deg, #FF8A5B, #FF5A5F); }
.progress-text { font-size: 22rpx; color: #6B7180; margin-left: 16rpx; }

.hw-foot { display: flex; justify-content: flex-end; margin-top: 20rpx; }
.submit-mini {
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  background: var(--primary-light);
  color: var(--primary-deep);
  font-size: 26rpx;
  font-weight: 600;
}

.empty { text-align: center; color: #A6ABC0; padding: 100rpx 0; }
.done-tip { margin-top: 12rpx; text-align: right; }

/* 截止提醒：今天截止用警示色，明天截止用信息色 */
.due-tip {
  margin: 24rpx 28rpx 0;
  padding: 20rpx 26rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  background: var(--primary-light);
  color: var(--primary-deep);
  font-weight: 600;
}
.due-tip--urgent {
  background: #FFF1F1;
  color: #E23B41;
}

/* 提交面板 */
.sub-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 24, 35, 0.45);
  z-index: 20;
}
.sub-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
}
.sub-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sub-title { font-size: 32rpx; font-weight: 700; }
.sub-close { font-size: 26rpx; color: var(--text-sub); }
.sub-name { margin-top: 6rpx; font-size: 24rpx; }

.sub-text {
  width: 100%;
  height: 200rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  background: #F5F6FA;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.sub-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}
.sub-img {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #F0F2F8;
}
.sub-img image { width: 100%; height: 100%; }
.sub-img-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
}
.sub-img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  border: 2rpx dashed #D5D9E6;
  border-radius: 14rpx;
  color: var(--text-sub);
  font-size: 36rpx;
}
.sub-img-tip { font-size: 22rpx; margin-top: 4rpx; }

.sub-btn { margin-top: 28rpx; width: 100%; }
