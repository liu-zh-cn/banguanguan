/* ============ 全局现代化主题 ============ */
page {
  --primary: #5B7CFF;
  --primary-deep: #3D5AFE;
  --primary-light: #EAEEFF;
  --accent: #24C8A0;
  --warn: #FFB020;
  --danger: #FF5A5F;
  --text: #1F2430;
  --text-sub: #8A90A2;
  --card-bg: #FFFFFF;
  --page-bg: #F5F6FA;
  /* 二级/三级文字与分隔线、填充色：亮色值与原写死色完全一致，页面视觉不变 */
  --brand-2: #7E5BFF;
  --text-2: #6B7180;
  --text-3: #A6ABC0;
  --text-4: #3A4152;
  --text-5: #5A6072;
  --text-6: #4A5060;
  --line: #F2F3F7;
  --line-2: #C7CBDA;
  --fill: #F0F2F8;
  --fill-2: #EEF0F5;
  --fill-3: #F7F8FC;
  --fill-4: #F0F2F7;
  background: var(--page-bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

view, text, button { box-sizing: border-box; }

/* 页面容器：给底部导航留白 */
.page {
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 渐变头部 */
.hero {
  background: linear-gradient(135deg, #5B7CFF 0%, #7E5BFF 100%);
  padding: 40rpx 36rpx 90rpx;
  color: #fff;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}
.hero-title { font-size: 44rpx; font-weight: 700; }
.hero-sub { font-size: 26rpx; opacity: 0.85; margin-top: 10rpx; }

/* 通用卡片 */
.card {
  background: var(--card-bg);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 24rpx 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(61, 90, 254, 0.08);
}
.card-raised { margin-top: -60rpx; position: relative; z-index: 2; }

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.section-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  background: var(--primary);
  border-radius: 8rpx;
  margin-right: 14rpx;
}

/* 徽标 / 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
}
.tag-blue { background: var(--primary-light); color: var(--primary-deep); }
.tag-green { background: #D8F6EE; color: #0F9D77; }
.tag-orange { background: #FFF0D6; color: #D98A00; }
.tag-red { background: #FFE1E2; color: #E23B41; }

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #5B7CFF, #3D5AFE);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  text-align: center;
  border: none;
  box-shadow: 0 10rpx 24rpx rgba(61, 90, 254, 0.3);
}
.btn-primary::after { border: none; }
.btn-ghost {
  background: #fff;
  color: var(--primary-deep);
  border: 2rpx solid var(--primary);
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
  text-align: center;
}

/* 文本工具 */
.muted { color: var(--text-sub); font-size: 24rpx; }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }

/* ============ 深色模式 ============
   只在这换变量：页面里所有颜色都已经走 var()，所以不用逐个页面改。
   需要在 app.json 里开 "darkmode": true，WXSS 的 prefers-color-scheme 才会生效。 */
@media (prefers-color-scheme: dark) {
  page {
    --primary: #7D95FF;
    --primary-deep: #9DB0FF;
    --primary-light: #232C45;
    --accent: #35D6AE;
    --text: #E8EBF3;
    --text-sub: #98A1B6;
    --text-2: #AEB6C8;
    --text-3: #8B93A8;
    --text-4: #D5DAE6;
    --text-5: #B6BDCD;
    --text-6: #C9CFDC;
    --line: #2A2F3D;
    --line-2: #3B4252;
    --fill: #232836;
    --fill-2: #1F2430;
    --fill-3: #1C212B;
    --fill-4: #202531;
    --card-bg: #1B1F29;
    --page-bg: #12151C;
  }

  /* 卡片阴影在深色下会变成一圈脏边，换成更淡的描边 */
  .card {
    box-shadow: none;
    border: 1rpx solid #262B38;
  }

  /* 标签底色在深色下要压暗，否则一排亮色块很刺眼 */
  .tag-blue { background: #232C45; }
  .tag-green { background: #14312A; color: #4FE0B6; }
  .tag-orange { background: #352914; color: #FFC24D; }
  .tag-red { background: #3A1C1F; color: #FF8A8E; }
}
.strong { font-weight: 700; }

/* ============ 手动主题 ============
   用户在上设置里选了「深色 / 浅色」时，页面根节点会挂上对应类。
   类选择器优先级高于 page，因此能压过系统的 prefers-color-scheme。
   选「跟随系统」时不挂类，走上面的 @media。 */
.theme-dark,
.theme-light {
  min-height: 100vh;
  background: var(--page-bg);
  color: var(--text);
}

.theme-dark {
  --primary: #7D95FF;
  --primary-deep: #9DB0FF;
  --primary-light: #232C45;
  --accent: #35D6AE;
  --text: #E8EBF3;
  --text-sub: #98A1B6;
  --text-2: #AEB6C8;
  --text-3: #8B93A8;
  --text-4: #D5DAE6;
  --text-5: #B6BDCD;
  --text-6: #C9CFDC;
  --line: #2A2F3D;
  --line-2: #3B4252;
  --fill: #232836;
  --fill-2: #1F2430;
  --fill-3: #1C212B;
  --fill-4: #202531;
  --card-bg: #1B1F29;
  --page-bg: #12151C;
}
.theme-dark .card {
  box-shadow: none;
  border: 1rpx solid #262B38;
}
.theme-dark .tag-blue { background: #232C45; }
.theme-dark .tag-green { background: #14312A; color: #4FE0B6; }
.theme-dark .tag-orange { background: #352914; color: #FFC24D; }
.theme-dark .tag-red { background: #3A1C1F; color: #FF8A8E; }

.theme-light {
  --primary: #5B7CFF;
  --primary-deep: #3D5AFE;
  --primary-light: #EAEEFF;
  --accent: #24C8A0;
  --brand-2: #7E5BFF;
  --text: #1F2430;
  --text-sub: #8A90A2;
  --text-2: #6B7180;
  --text-3: #A6ABC0;
  --text-4: #3A4152;
  --text-5: #5A6072;
  --text-6: #4A5060;
  --line: #F2F3F7;
  --line-2: #C7CBDA;
  --fill: #F0F2F8;
  --fill-2: #EEF0F5;
  --fill-3: #F7F8FC;
  --fill-4: #F0F2F7;
  --card-bg: #FFFFFF;
  --page-bg: #F5F6FA;
}
