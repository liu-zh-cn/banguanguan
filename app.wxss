/* ============ 全局现代化主题 ============ */
page {
  --primary: #5B7CFF;
  --primary-deep: #3D5AFE;
  --primary-light: #EAEEFF;
  --accent: #24C8A0;
  --warn: #FFB020;
  --danger: #FF5A5F;
  --text: #1F2430;
  --text-sub: #8A90A2;
  --card-bg: #FFFFFF;
  --page-bg: #F5F6FA;
  background: var(--page-bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

view, text, button { box-sizing: border-box; }

/* 页面容器：给底部导航留白 */
.page {
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 渐变头部 */
.hero {
  background: linear-gradient(135deg, #5B7CFF 0%, #7E5BFF 100%);
  padding: 40rpx 36rpx 90rpx;
  color: #fff;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}
.hero-title { font-size: 44rpx; font-weight: 700; }
.hero-sub { font-size: 26rpx; opacity: 0.85; margin-top: 10rpx; }

/* 通用卡片 */
.card {
  background: var(--card-bg);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 24rpx 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(61, 90, 254, 0.08);
}
.card-raised { margin-top: -60rpx; position: relative; z-index: 2; }

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.section-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  background: var(--primary);
  border-radius: 8rpx;
  margin-right: 14rpx;
}

/* 徽标 / 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
}
.tag-blue { background: var(--primary-light); color: var(--primary-deep); }
.tag-green { background: #D8F6EE; color: #0F9D77; }
.tag-orange { background: #FFF0D6; color: #D98A00; }
.tag-red { background: #FFE1E2; color: #E23B41; }

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #5B7CFF, #3D5AFE);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  text-align: center;
  border: none;
  box-shadow: 0 10rpx 24rpx rgba(61, 90, 254, 0.3);
}
.btn-primary::after { border: none; }
.btn-ghost {
  background: #fff;
  color: var(--primary-deep);
  border: 2rpx solid var(--primary);
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
  text-align: center;
}

/* 文本工具 */
.muted { color: var(--text-sub); font-size: 24rpx; }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
.strong { font-weight: 700; }
